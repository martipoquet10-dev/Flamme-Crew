# Copy this file to server/.env and fill in the values.

# Which client folder in tenants/ this server runs
CREW_TENANT=flamme-burger

# Port and network interface (0.0.0.0 = reachable from phones on the same Wi-Fi)
PORT=8090
HOST=0.0.0.0

# PIN for anyone who has not set a personal PIN yet. Leave empty to disable (recommended in production).
CREW_DEMO_PIN=1234

# AI assistant (Claude). Get a key at https://console.anthropic.com — usage is billed per request.
ANTHROPIC_API_KEY=
# CREW_AI_MODEL=claude-opus-5-5
